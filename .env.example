NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=anigos-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin SDK (server-only; never expose as NEXT_PUBLIC_* or commit values)
